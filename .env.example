# Copy to .env and adjust. Never commit .env. Placeholders only — no real secrets here.

# ---- Backend ----
ENVIRONMENT=local                     # local | test | staging | production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-environment
DATABASE_URL=postgresql+psycopg://elsakka:elsakka@localhost:5433/elsakka
CORS_ORIGINS=http://localhost:3000    # comma-separated; never "*" in staging/production
LOG_LEVEL=INFO

# ---- Local Postgres (docker compose) ----
POSTGRES_USER=elsakka
POSTGRES_PASSWORD=elsakka
POSTGRES_DB=elsakka
POSTGRES_PORT=5433

# ---- Frontend ----
# Where the Next.js dev server proxies /api/* (server-side only).
API_ORIGIN=http://localhost:8000

# ---- Integrations (added by later features; dev adapters by default) ----
# WHATSAPP_PROVIDER=dev
# OCR_PROVIDER=dev
# STORAGE_ENDPOINT_URL=
# STORAGE_BUCKET=
